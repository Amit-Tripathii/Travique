<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/show.css">


<div class="container listing-details">

    <!-- =========================
         LISTING HEADER
    ========================== -->

    <div class="listing-header">

        <h1 class="listing-title">
            <%= listing.title %>
        </h1>

        <div class="listing-meta">
            <i class="fa-solid fa-location-dot me-1"></i>
            <%= listing.location %>, <%= listing.country %>
        </div>

    </div>


    <!-- =========================
         MAIN IMAGE
    ========================== -->

    <img
        src="<%= listing.image.url %>"
        class="main-image"
        alt="<%= listing.title %>"
    >


    <div class="row mt-4">

        <!-- =========================
             LEFT CONTENT
        ========================== -->

        <div class="col-lg-7">

            <div class="listing-info">

                <p class="owner">
                    Hosted by
                    <strong>
                        <%= listing.owner.username %>
                    </strong>
                </p>


                <h4 class="mb-3">
                    About this place
                </h4>

                <p class="listing-description">
                    <%= listing.description %>
                </p>


                <hr class="my-4">


                <div class="row">

                    <div class="col-md-6 mb-3">

                        <i class="fa-solid fa-location-dot text-danger me-2"></i>

                        <strong>Location</strong>

                        <p class="text-muted ms-4 mb-0">
                            <%= listing.location %>
                        </p>

                    </div>


                    <div class="col-md-6 mb-3">

                        <i class="fa-solid fa-earth-americas text-danger me-2"></i>

                        <strong>Country</strong>

                        <p class="text-muted ms-4 mb-0">
                            <%= listing.country %>
                        </p>

                    </div>

                </div>

            </div>


            <!-- OWNER ACTIONS -->

            <% if(currUser && listing.owner._id.equals(currUser._id)) { %>

                <div class="owner-actions">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn btn-dark edit-btn"
                    >
                        <i class="fa-solid fa-pen me-1"></i>
                        Edit listing
                    </a>


                    <form
                        action="/listings/<%= listing._id %>?_method=DELETE"
                        method="POST"
                    >

                        <button
                            type="submit"
                            class="btn btn-outline-danger delete-btn"
                        >
                            <i class="fa-solid fa-trash me-1"></i>
                            Delete
                        </button>

                    </form>

                </div>

            <% } %>

        </div>


        <!-- =========================
             PRICE CARD
        ========================== -->

        <div class="col-lg-5">

            <div class="booking-card">

                <div class="price">
                    &#8377;
                    <%= listing.price.toLocaleString("en-IN") %>
                    <span>/ night</span>
                </div>


                <div class="location">

                    <i class="fa-solid fa-location-dot me-2"></i>

                    <%= listing.location %>,
                    <%= listing.country %>

                </div>


                <hr>


                <div class="d-grid">

                    <button
                        class="btn travique-btn"
                        type="button"
                    >
                        Reserve
                    </button>

                </div>


                <p class="text-muted text-center small mt-3 mb-0">
                    You won't be charged yet
                </p>

            </div>

        </div>

    </div>


    <!-- =========================
         REVIEWS
    ========================== -->

    <div class="reviews-section">

        <h3 class="section-title">
            Reviews
        </h3>


        <% if(currUser) { %>

            <div class="review-form">

                <h5 class="mb-3">
                    Leave a review
                </h5>


                <form
                    action="/listings/<%= listing.id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >

                    <div class="mb-3">

                        <label
                            for="rating"
                            class="form-label"
                        >
                            Rating
                        </label>


                        <fieldset class="starability-slot">

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="1"
                                checked
                                aria-label="No rating."
                            />

                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                            />

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>


                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>


                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>

                        </fieldset>

                    </div>


                    <div class="mb-3">

                        <label
                            for="comment"
                            class="form-label"
                        >
                            Comments
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="5"
                            class="form-control"
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please provide your comments.
                        </div>

                    </div>


                    <button
                        type="submit"
                        class="btn travique-btn"
                    >
                        Submit review
                    </button>

                </form>

            </div>

        <% } %>


        <!-- EXISTING REVIEWS -->

        <% if(listing.reviews.length > 0) { %>

            <div class="row g-4">

                <% for (let review of listing.reviews) { %>

                    <div class="col-md-6">

                        <div class="review-card">

                            <div class="card-body p-4">

                                <div class="review-author">
                                    <i class="fa-regular fa-user me-2"></i>
                                    @<%= review.author.username %>
                                </div>


                                <p
                                    class="starability-result mb-3"
                                    data-rating="<%= review.rating %>"
                                ></p>


                                <p class="review-comment mb-3">
                                    <%= review.comment %>
                                </p>


                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST"
                                >

                                    <button
                                        class="btn btn-sm btn-outline-danger"
                                        type="submit"
                                    >
                                        <i class="fa-solid fa-trash me-1"></i>
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>

        <% } else { %>

            <p class="text-muted">
                No reviews yet. Be the first to review this place.
            </p>

        <% } %>

    </div>


    <!-- =========================
         MAP
    ========================== -->

    <div class="map-section">

        <h3 class="section-title">
            Where you'll be
        </h3>

        <div id="map"></div>

    </div>

</div>


<!-- =========================
     MAP DATA
========================== -->

<script>

    const listingLocation =
        "<%= listing.location %>";

    const coordinates =
        <%- JSON.stringify(
            listing.geometry?.coordinates ||
            [77.2090, 28.6139]
        ) %>;

</script>


<script src="/js/map.js"></script>

<script
    src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.MAP_TOKEN %>&callback=initMap"
    async
    defer>
</script>