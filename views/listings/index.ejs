<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/home.css">

<!-- =========================
     CATEGORY FILTERS
========================= -->

<div class="filters-wrapper">

    <div id="filters">

        <div class="filter active">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-mountain-city"></i>
            <p>Iconic Cities</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </div>

        <div class="filter">
            <i class="fa-brands fa-fort-awesome"></i>
            <p>Castles</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-campground"></i>
            <p>Camping</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-cow"></i>
            <p>Farms</p>
        </div>

        <div class="filter">
            <i class="fa-regular fa-snowflake"></i>
            <p>Arctic</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-landmark-dome"></i>
            <p>Domes</p>
        </div>

        <div class="filter">
            <i class="fa-solid fa-sailboat"></i>
            <p>Sailboats</p>
        </div>

        <!-- Tax Toggle -->

        <div class="tax-toggle-wrapper">

            <div class="tax-toggle">

                <div class="form-check form-switch">

                    <input
                        class="form-check-input"
                        type="checkbox"
                        role="switch"
                        id="switchCheckDefault"
                    >

                    <label
                        class="form-check-label"
                        for="switchCheckDefault"
                    >
                        Display total after taxes
                    </label>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================
     LISTINGS
========================= -->

<div class="container-fluid px-lg-4">

    <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 listings-container">
        <% for(let listing of allListings) { %>

            <div class="col">

                <a
                    href="/listings/<%= listing._id %>"
                    class="listing-link"
                >

                    <div class="listing-card">

                        <!-- Image -->

                        <div class="listing-image-wrapper">

                            <img
                                src="<%= listing.image.url %>"
                                class="listing-image"
                                alt="<%= listing.title %>"
                            >

                            <!-- Favorite -->

                            <button
                                class="favorite-btn"
                                type="button"
                                onclick="event.preventDefault();"
                                aria-label="Add to favorites"
                            >
                                <i class="fa-regular fa-heart"></i>
                            </button>

                        </div>


                        <!-- Details -->

                        <div class="listing-body">

                            <div class="listing-title">
                                <%= listing.title %>
                            </div>

                            <div class="listing-location">
                                <i class="fa-solid fa-location-dot me-1"></i>
                                Explore this destination
                            </div>

                            <p class="listing-price">

                                <strong>
                                    &#8377; <%= listing.price.toLocaleString("en-IN") %>
                                </strong>

                                / night

                                <span class="tax-info">
                                    &nbsp; +18% GST
                                </span>

                            </p>

                        </div>

                    </div>

                </a>

            </div>

        <% } %>

    </div>

</div>


<!-- =========================
     TAX TOGGLE SCRIPT
========================= -->

<script>

    const taxToggle =
        document.getElementById("switchCheckDefault");

    taxToggle.addEventListener("change", () => {

        const taxInfo =
            document.getElementsByClassName("tax-info");

        for (const info of taxInfo) {

            if (taxToggle.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }

        }

    });

</script>