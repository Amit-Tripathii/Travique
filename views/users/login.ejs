<% layout('/layouts/boilerplate') %>

<link rel="stylesheet" href="/css/auth.css">

<div class="auth-page">

    <div class="auth-card">

        <!-- Logo -->

        <div class="auth-logo">
            <a href="/listings">
                <i class="fa-regular fa-compass"></i>
                Travique
            </a>
        </div>


        <!-- Heading -->

        <h1 class="auth-title">
            Welcome back
        </h1>

        <p class="auth-subtitle">
            Log in to continue exploring amazing places.
        </p>


        <!-- Login Form -->

        <form
            action="/login"
            method="POST"
            class="needs-validation"
            novalidate
        >

            <!-- Username -->

            <div class="mb-3">

                <label
                    for="username"
                    class="form-label auth-label"
                >
                    Username
                </label>

                <input
                    name="username"
                    id="username"
                    placeholder="Enter your username"
                    type="text"
                    class="form-control auth-input"
                    required
                    autocomplete="username"
                >

                <div class="invalid-feedback">
                    Please enter your username.
                </div>

            </div>


            <!-- Password -->

            <div class="mb-4">

                <label
                    for="password"
                    class="form-label auth-label"
                >
                    Password
                </label>

                <input
                    name="password"
                    id="password"
                    placeholder="Enter your password"
                    type="password"
                    class="form-control auth-input"
                    required
                    autocomplete="current-password"
                >

                <div class="invalid-feedback">
                    Please enter your password.
                </div>

            </div>


            <!-- Submit -->

            <button
                type="submit"
                class="auth-btn"
            >
                Log In
            </button>

        </form>


        <!-- Signup -->

        <div class="auth-footer">

            Don't have an account?

            <a href="/signup">
                Sign up
            </a>

        </div>

    </div>

</div>