<% layout('/layouts/boilerplate') %>

<link rel="stylesheet" href="/css/auth.css" />

<div class="auth-page">
  <div class="auth-card">
    <!-- Logo -->

    <div class="auth-logo">
      <a href="/listings">
        <i class="fa-regular fa-compass"></i>
        Travique
      </a>
    </div>

    <!-- Heading -->

    <h1 class="auth-title">Create your account</h1>

    <p class="auth-subtitle">
      Join Travique and start discovering amazing places.
    </p>

    <!-- Signup Form -->

    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <!-- Username -->

      <div class="mb-3">
        <label for="username" class="form-label auth-label"> Username </label>

        <input
          name="username"
          id="username"
          placeholder="Choose a username"
          type="text"
          class="form-control auth-input"
          required
          autocomplete="username"
        />

        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <!-- Email -->

      <div class="mb-3">
        <label for="email" class="form-label auth-label"> Email </label>

        <input
          name="email"
          id="email"
          placeholder="Enter your email"
          type="email"
          class="form-control auth-input"
          required
          autocomplete="email"
        />

        <div class="invalid-feedback">Please enter a valid email address.</div>
      </div>

      <!-- Password -->

      <div class="mb-4">
        <label for="password" class="form-label auth-label"> Password </label>

        <input
          name="password"
          id="password"
          placeholder="Create a password"
          type="password"
          class="form-control auth-input"
          required
          autocomplete="new-password"
        />

        <div class="invalid-feedback">Please create a password.</div>
      </div>

      <!-- Submit -->

      <button type="submit" class="auth-btn">Create Account</button>
    </form>

    <!-- Login -->

    <div class="auth-footer">
      Already have an account?

      <a href="/login"> Log in </a>
    </div>
  </div>
</div>
